<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HoldKeyPlugin</AssemblyName>
    <Version>1.1.0.0</Version>
    <Authors>Thallys Florentino</Authors>
    <Description>Cross-platform hold-key bindings with autorepeat and safe key release for OpenTabletDriver.</Description>
    <RepositoryUrl>https://github.com/vansearch/NativeHoldKey</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTabletDriver.Plugin" Version="0.6.7" />
  </ItemGroup>
</Project>
